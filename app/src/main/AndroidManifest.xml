<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 上游的演示资源在 R2 CDN；编辑器本身离线可用。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      usesCleartextTraffic：AI 连接要访问用户自填的 http 内网服务
      （如 http://192.168.x.x:8080/v1）。targetSdk ≥ 28 默认禁止明文流量，
      WebView 的网络栈同样受此约束，不放开会直接吃 ERR_CLEARTEXT_NOT_PERMITTED。
    -->
    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.RezeDesignAndroid"
        android:usesCleartextTraffic="true">

        <!--
          configChanges：屏幕方向跟随系统（不锁定），用户转机即转屏。
          但安卓默认会在旋转时销毁并重建 Activity，WebView 随之重建、页面重载，
          编辑器里未保存的场景（模型、动作、相机）就没了 —— 所以必须在这里拦住，
          让 WebView 自己重排而不是重建。

          壳不替用户做方向的策略决定：上游是响应式布局，横竖屏都能用，
          也就省掉了额外的旋转按钮 UI。
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>